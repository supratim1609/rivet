# Environment Variables Template
# Copy this to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-super-secret-key-change-this-to-a-random-string
JWT_EXPIRY_HOURS=1

# ============================================
# OAuth - Google
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ============================================
# OAuth - GitHub
# ============================================
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# ============================================
# Database (if using ORM)
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/rivet_db
# Or for MySQL:
# DATABASE_URL=mysql://user:password@localhost:3306/rivet_db

# ============================================
# Server Configuration
# ============================================
PORT=3000
HOST=0.0.0.0
ENVIRONMENT=development

# ============================================
# Security
# ============================================
BCRYPT_ROUNDS=12
ENABLE_CORS=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================
# Hot Reload (Development)
# ============================================
HOT_RELOAD=true
WATCH_DIRECTORY=lib

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
# Options: debug, info, warning, error

# ============================================
# Rate Limiting (Future)
# ============================================
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=15
